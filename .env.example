# Optional official TypeSafe key. Leave blank for deterministic local tools.
# Prefer the private file created by `npm run setup`; never commit credentials.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
FUSION_FALLBACK=host
FUSION_MCP_PROFILE=assist

# Local stdio accepts host-selected absolute project roots by default.
# FUSION_WORKSPACE_ACCESS=host
# Use restricted to enforce the configured exact-root allowlist.
# Exact canonical root defaults to the MCP process working directory.
# FUSION_WORKSPACE_ROOT=/absolute/path/to/project
# Additional exact roots use ; on Windows, : on Linux/macOS.
# FUSION_WORKSPACE_ALLOWED_ROOTS=/absolute/path/to/another-project

# Optional uncalibrated thresholds; tune on your own workload.
# FUSION_MIN_CONFIDENCE=0.8
# FUSION_MIN_PROBABILITY=0.7
# FUSION_MIN_MARGIN=0.2

# Pricing is unknown unless all three are explicitly set to actual provider rates.
# Do not set every value to zero merely to silence a warning.
# JEV_INPUT_USD_PER_MILLION=
# JEV_CACHED_INPUT_USD_PER_MILLION=
# JEV_OUTPUT_USD_PER_MILLION=
