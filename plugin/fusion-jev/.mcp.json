{
  "mcpServers": {
    "fusion": {
      "command": "npx",
      "args": [
        "-y",
        "--package=fusion-jev-mcp@0.3.1",
        "fusion-jev",
        "stdio"
      ],
      "env_vars": [
        "TYPESAFE_API_KEY",
        "JEV_API_KEY",
        "FUSION_ENV_FILE",
        "FUSION_CATALOG_JSON",
        "FUSION_WORKSPACE_ROOT",
        "FUSION_WORKSPACE_ALLOWED_ROOTS",
        "NODE_OPTIONS"
      ]
    }
  }
}
