{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.cjs\"", "timeout": 5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pretool.cjs\"", "timeout": 3 }]
      }
    ]
  }
}
